{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and windows made by detach_tab (w2, w3, ...)",
  "windows": [
    "main",
    "w*"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "core:window:allow-set-theme",
    "core:window:allow-close",
    "clipboard-manager:allow-write-text"
  ]
}
