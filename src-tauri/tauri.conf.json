{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "markview",
  "version": "0.3.4",
  "identifier": "com.gyuha.markview",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "markview",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJDMzY3RDgwRTkwNjY1NzYKUldSMlpRYnBnSDAydk9JcnRYWUs5NTFYb2wxQWRKWGY4NGx3d3V3akdyUlpUYkFqQXJjdVcvaWQK",
      "endpoints": ["https://github.com/gyuha/markview/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd"
        ],
        "name": "Markdown Document",
        "description": "마크다운 문서",
        "role": "Viewer",
        "mimeType": "text/markdown"
      }
    ]
  }
}